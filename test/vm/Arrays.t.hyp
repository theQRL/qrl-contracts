pragma hyperion >=0.0;

import {Arrays} from "../../utils/Arrays.hyp";
import {Comparators} from "../../utils/Comparators.hyp";

contract ArraysTest {
    address private constant LOW = address(uint512(3));
    address private constant MID = address(uint512(1) << 300);
    address private constant HIGH = address((uint512(1) << 500) | 1);

    function _descendingAccounts(address a, address b) private pure returns (bool) {
        return uint512(a) > uint512(b);
    }

    function _descendingWords(bytes32 a, bytes32 b) private pure returns (bool) {
        return a > b;
    }

    function testSortUint() external pure {
        uint256[] memory array = new uint256[](3);
        array[0] = 3;
        array[1] = 1;
        array[2] = 2;
        Arrays.sort(array);
        require(array.length == 3);
        require(array[0] == 1 && array[1] == 2 && array[2] == 3);
    }

    function testSortUintWithComparator() external pure {
        uint256[] memory array = new uint256[](5);
        array[0] = 3;
        array[1] = type(uint256).max;
        array[2] = 0;
        array[3] = 3;
        array[4] = 1 << 200;
        Arrays.sort(array, Comparators.gt);
        require(array[0] == type(uint256).max && array[1] == 1 << 200);
        require(array[2] == 3 && array[3] == 3 && array[4] == 0);
    }

    function testSortLeavesNeighbouringMemoryIntact() external pure {
        uint256[] memory before = new uint256[](1);
        before[0] = 111;
        uint256[] memory array = new uint256[](4);
        array[0] = 4;
        array[1] = 3;
        array[2] = 2;
        array[3] = 1;
        uint256[] memory afterwards = new uint256[](1);
        afterwards[0] = 222;
        Arrays.sort(array);
        require(before.length == 1 && before[0] == 111);
        require(afterwards.length == 1 && afterwards[0] == 222);
        require(array[0] == 1 && array[1] == 2 && array[2] == 3 && array[3] == 4);
    }

    function testSortOfShortArrays() external pure {
        uint256[] memory empty = new uint256[](0);
        Arrays.sort(empty);
        require(empty.length == 0);
        uint256[] memory single = new uint256[](1);
        single[0] = 9;
        Arrays.sort(single);
        require(single.length == 1 && single[0] == 9);
    }

    function testSortAddressesComparesWholeAddress() external pure {
        address[] memory array = new address[](3);
        array[0] = HIGH;
        array[1] = LOW;
        array[2] = MID;
        Arrays.sort(array);
        require(array[0] == LOW && array[1] == MID && array[2] == HIGH);

        Arrays.sort(array, _descendingAccounts);
        require(array[0] == HIGH && array[1] == MID && array[2] == LOW);
    }

    function testSortBytes32() external pure {
        bytes32[] memory array = new bytes32[](3);
        array[0] = bytes32(uint256(3) << 248);
        array[1] = bytes32(uint256(1));
        array[2] = bytes32(uint256(2) << 128);
        Arrays.sort(array);
        require(array[0] == bytes32(uint256(1)));
        require(array[1] == bytes32(uint256(2) << 128));
        require(array[2] == bytes32(uint256(3) << 248));

        Arrays.sort(array, _descendingWords);
        require(array[0] == bytes32(uint256(3) << 248));
        require(array[2] == bytes32(uint256(1)));
    }

    function testUnsafeMemoryAccess() external pure {
        uint256[] memory numbers = new uint256[](3);
        numbers[0] = 10;
        numbers[1] = 20;
        numbers[2] = 30;
        require(Arrays.unsafeMemoryAccess(numbers, 0) == 10);
        require(Arrays.unsafeMemoryAccess(numbers, 1) == 20);
        require(Arrays.unsafeMemoryAccess(numbers, 2) == 30);

        address[] memory accounts = new address[](3);
        accounts[0] = LOW;
        accounts[1] = MID;
        accounts[2] = HIGH;
        require(Arrays.unsafeMemoryAccess(accounts, 0) == LOW);
        require(Arrays.unsafeMemoryAccess(accounts, 1) == MID);
        require(Arrays.unsafeMemoryAccess(accounts, 2) == HIGH);

        bytes32[] memory words = new bytes32[](2);
        words[0] = keccak256("a");
        words[1] = keccak256("b");
        require(Arrays.unsafeMemoryAccess(words, 0) == keccak256("a"));
        require(Arrays.unsafeMemoryAccess(words, 1) == keccak256("b"));

        bytes[] memory blobs = new bytes[](2);
        blobs[0] = hex"01";
        blobs[1] = hex"0203";
        require(keccak256(Arrays.unsafeMemoryAccess(blobs, 0)) == keccak256(hex"01"));
        require(keccak256(Arrays.unsafeMemoryAccess(blobs, 1)) == keccak256(hex"0203"));

        string[] memory texts = new string[](2);
        texts[0] = "one";
        texts[1] = "two";
        require(keccak256(bytes(Arrays.unsafeMemoryAccess(texts, 0))) == keccak256("one"));
        require(keccak256(bytes(Arrays.unsafeMemoryAccess(texts, 1))) == keccak256("two"));
    }

    function testMemorySearch() external pure {
        uint256[] memory array = new uint256[](4);
        array[0] = 10;
        array[1] = 20;
        array[2] = 20;
        array[3] = 40;
        require(Arrays.lowerBoundMemory(array, 20) == 1);
        require(Arrays.upperBoundMemory(array, 20) == 3);
        require(Arrays.lowerBoundMemory(array, 41) == 4);
        require(Arrays.upperBoundMemory(array, 5) == 0);
    }
}
